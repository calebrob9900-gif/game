{
  "name": "neon-breach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NEON BREACH — a browser competitive shooter (CoD-feel gunplay, GTA-flavored urban maps, FP/TP, bots). CC0 assets.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "PW_PORT=4173 playwright test --project=e2e",
    "test:visual": "PW_PORT=4174 playwright test --project=visual",
    "test:perf": "node scripts/perf-budget.mjs && PW_PORT=4175 playwright test --project=perf",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "howler": "^2.2.4",
    "miniplex": "^2.0.0",
    "recast-navigation": "^0.39.0",
    "three": "^0.184.0",
    "yuka": "^0.7.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "1.56.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.10.5",
    "@types/three": "^0.184.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "fast-check": "^3.23.2",
    "lighthouse": "^12.8.2",
    "memlab": "^1.1.59",
    "playwright": "1.56.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
